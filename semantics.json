        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "feedbackTextColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Feedback text color",
        "default": "#333333",
        "importance": "low",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [
          {
            "name": "RangeList",
            "label": "Default"
          }
        ],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Bad score, 21-91% Average Score, 91-100% Great Score!",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "importance": "low",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score Range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "label": "Feedback for defined score range",
              "importance": "low",
              "placeholder": "Fill in the feedback",
              "optional": true
            },
            {
              "name": "appearance",
              "type": "group",
              "label": "Appearance settings",
              "importance": "low",
              "expanded": false,
              "optional": true,
              "fields": [
                {
                  "name": "feedbackLeadText",
                  "type": "text",
                  "label": "Highlighted lead text",
                  "importance": "low",
                  "placeholder": "e.g. Correct! or Incorrect",
                  "optional": true
                },
                {
                  "name": "feedbackLeadBold",
                  "type": "boolean",
                  "label": "Bold lead text",
                  "importance": "low",
                  "default": true
                },
                {
                  "name": "feedbackLeadTextColor",
                  "type": "text",
                  "widget": "colorSelector",
                  "label": "Highlighted lead text color",
                  "default": "#1a73d9",
                  "importance": "low",
                  "optional": true,
                  "spectrum": {
                    "showInput": true
                  }
                },
                {
                  "name": "feedbackTextAlign",
                  "type": "select",
                  "label": "Text alignment",
                  "description": "Only used when no feedback image is set. With an image, text alignment follows image position (left/right: left aligned, above: centered).",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "left",
                      "label": "Left"
                    },
                    {
                      "value": "center",
                      "label": "Center"
                    },
                    {
                      "value": "right",
                      "label": "Right"
                    }
                  ]
                },
                {
                  "name": "feedbackImage",
                  "type": "image",
                  "label": "Feedback image",
                  "importance": "low",
                  "optional": true
                },
                {
                  "name": "feedbackImagePosition",
                  "type": "select",
                  "label": "Image position",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "above",
                      "label": "Above text"
                    },
                    {
                      "value": "left",
                      "label": "Left of text"
                    },
                    {
                      "value": "right",
                      "label": "Right of text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "name": "alternativeLabels",
    "type": "group",
    "label": "Alternative labels",
    "importance": "medium",
    "optional": true,
    "fields": [
      {
        "name": "enabled",
        "type": "boolean",
        "label": "Show labels on alternatives",
        "default": false
      },
      {
        "name": "style",
        "type": "select",
        "label": "Label style",
        "default": "uppercase",
        "options": [
          {
            "value": "numbers",
            "label": "Numbers (1, 2, 3)"
          },
          {
            "value": "uppercase",
            "label": "Uppercase letters (A, B, C)"
          },
          {
            "value": "lowercase",
            "label": "Lowercase letters (a, b, c)"
          },
          {
            "value": "upperRoman",
            "label": "Uppercase Roman numerals (I, II, III)"
          },
          {
            "value": "lowerRoman",
            "label": "Lowercase Roman numerals (i, ii, iii)"
          }
        ],
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "enabled",
              "equals": true
            }
          ]
        }
      },
      {
        "name": "separator",
        "type": "select",
        "label": "Separator after label",
        "default": "period",
        "options": [
          {
            "value": "period",
            "label": "Period (A.)"
