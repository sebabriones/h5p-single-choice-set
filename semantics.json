  {
    "name": "choices",
    "type": "list",
    "label": "List of questions",
    "importance": "high",
    "entity": "question",
    "min": 1,
    "defaultNum": 2,
    "widgets": [
      {
        "name": "ListEditor",
        "label": "Default"
      },
      {
        "name": "SingleChoiceSetTextualEditor",
        "label": "Textual"
      }
    ],
    "field": {
      "name": "choice",
      "type": "group",
      "isSubContent": true,
      "label": "Question & alternatives",
      "importance": "high",
      "fields": [
        {
          "name": "question",
          "type": "text",
          "widget": "html",
          "tags": [
            "p",
            "br",
            "strong",
            "em",
            "code"
          ],
          "label": "Question",
          "importance": "high"
        },
        {
          "name": "context",
          "type": "group",
          "label": "Context (optional)",
          "importance": "low",
          "optional": true,
          "fields": [
            {
              "name": "text",
              "type": "text",
              "widget": "html",
              "label": "Context text",
              "importance": "medium",
              "optional": true,
              "description": "Optional supporting text shown beside the question.",
              "tags": [
                "p",
                "br",
                "strong",
                "em",
                "ul",
                "ol",
                "li",
                "code"
              ]
            },
            {
              "name": "media",
              "type": "group",
              "label": "Context image",
              "importance": "medium",
              "optional": true,
              "fields": [
                {
                  "name": "type",
                  "type": "library",
                  "label": "Image",
                  "importance": "medium",
                  "options": [
                    "H5P.Image 1.1"
                  ],
                  "optional": true,
                  "description": "Optional image shown beside the question."
                },
                {
                  "name": "disableImageZooming",
                  "type": "boolean",
                  "label": "Disable image zooming",
                  "importance": "low",
                  "default": false,
                  "optional": true,
                  "widget": "showWhen",
                  "showWhen": {
                    "rules": [
                      {
                        "field": "type",
                        "equals": "H5P.Image 1.1"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "answers",
          "type": "list",
          "label": "Alternatives - first alternative is the correct one.",
          "importance": "medium",
          "entity": "answer",
          "min": 2,
          "max": 4,
          "defaultNum": 2,
          "field": {
            "name": "answer",
            "type": "text",
            "widget": "html",
            "tags": [
              "p",
              "br",
              "strong",
              "em",
              "code"
            ],
            "label": "Alternative",
            "importance": "medium"
          }
        }
      ]
    }
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall Feedback",
    "importance": "low",
    "expanded": true,
    "fields": [
      {
        "name": "popupBackgroundColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Popup background color",
        "default": "#ffffff",
