[
  {
    "name": "instructions",
    "type": "group",
    "label": "Instructions",
    "importance": "high",
    "optional": true,
    "fields": [
      {
        "name": "enabled",
        "type": "boolean",
        "label": "Show instructions",
        "default": false
      },
      {
        "name": "text",
        "type": "text",
        "widget": "html",
        "label": "Instructions text",
        "importance": "high",
        "optional": true,
        "tags": [
          "p",
          "br",
          "strong",
          "em",
          "ul",
          "ol",
          "li"
        ]
      },
      {
        "name": "displayMode",
        "type": "select",
        "label": "Display mode",
        "default": "both",
        "options": [
          {
            "value": "intro",
            "label": "Intro only"
          },
          {
            "value": "tab",
            "label": "Tab only"
          },
          {
            "value": "both",
            "label": "Intro and tab"
          }
        ]
      },
      {
        "name": "introButtonLabel",
        "type": "text",
        "label": "Intro button label",
        "default": "Start",
        "optional": true
      },
      {
        "name": "tabButtonLabel",
        "type": "text",
        "label": "Tab button label",
        "default": "Instructions",
        "optional": true
      },
      {
        "name": "startCollapsed",
        "type": "boolean",
        "label": "Collapse tab on load",
        "default": true
      },
      {
        "name": "animation",
        "type": "group",
        "label": "Animation",
        "importance": "low",
        "optional": true,
        "fields": [
          {
            "name": "introDuration",
            "type": "number",
            "label": "Intro curtain duration",
            "description": "Opening/closing speed for the intro curtain in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabDuration",
            "type": "number",
            "label": "Tab open/close duration",
            "description": "Opening/closing speed for the instructions tab in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabClosedOffset",
            "type": "number",
            "label": "Tab closed extra offset",
            "description": "Extra offset (in px) applied when the tab is closed. 0 keeps it flush; higher values hide it more.",
            "default": 0,
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "px"
          }
        ]
      }
    ]
  },
  {
    "name": "choices",
    "type": "list",
    "label": "List of questions",
    "importance": "high",
    "entity": "question",
    "min": 1,
    "defaultNum": 2,
    "widgets": [
      {
        "name": "ListEditor",
        "label": "Default"
      },
      {
        "name": "SingleChoiceSetTextualEditor",
        "label": "Textual"
      }
    ],
    "field": {
      "name": "choice",
      "type": "group",
      "isSubContent": true,
      "label": "Question & alternatives",
      "importance": "high",
      "fields": [
        {
          "name": "question",
          "type": "text",
          "widget": "html",
          "tags": [
            "p",
            "br",
            "strong",
            "em",
            "code"
          ],
          "label": "Question",
          "importance": "high"
        },
        {
          "name": "answers",
          "type": "list",
          "label": "Alternatives - first alternative is the correct one.",
          "importance": "medium",
          "entity": "answer",
          "min": 2,
          "max": 4,
          "defaultNum": 2,
          "field": {
            "name": "answer",
            "type": "text",
            "widget": "html",
            "tags": [
              "p",
              "br",
              "strong",
              "em",
              "code"
            ],
            "label": "Alternative",
            "importance": "medium"
          }
        }
      ]
    }
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall Feedback",
    "importance": "low",
    "expanded": true,
    "fields": [
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [
          {
            "name": "RangeList",
            "label": "Default"
          }
        ],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Bad score, 21-91% Average Score, 91-100% Great Score!",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "importance": "low",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score Range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "label": "Feedback for defined score range",
              "importance": "low",
              "placeholder": "Fill in the feedback",
              "optional": true
            }
          ]
        }
      }
    ]
  },
  {
    "name": "alternativeLabels",
    "type": "group",
    "label": "Alternative labels",
    "importance": "medium",
    "optional": true,
    "fields": [
      {
        "name": "enabled",
        "type": "boolean",
        "label": "Show labels on alternatives",
        "default": false
      },
      {
        "name": "style",
        "type": "select",
        "label": "Label style",
        "default": "uppercase",
        "options": [
          {
            "value": "numbers",
            "label": "Numbers (1, 2, 3)"
          },
          {
            "value": "uppercase",
            "label": "Uppercase letters (A, B, C)"
          },
          {
            "value": "lowercase",
            "label": "Lowercase letters (a, b, c)"
          },
          {
            "value": "upperRoman",
            "label": "Uppercase Roman numerals (I, II, III)"
          },
          {
            "value": "lowerRoman",
            "label": "Lowercase Roman numerals (i, ii, iii)"
          }
        ],
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "enabled",
              "equals": true
            }
          ]
        }
      },
      {
        "name": "separator",
        "type": "select",
        "label": "Separator after label",
        "default": "period",
        "options": [
          {
            "value": "period",
            "label": "Period (A.)"
          },
          {
            "value": "paren",
            "label": "Parenthesis ((A))"
          },
          {
            "value": "none",
            "label": "None (A)"
          }
        ],
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "enabled",
              "equals": true
            }
          ]
        }
      }
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "fields": [
      {
        "name": "autoContinue",
        "type": "boolean",
        "label": "Auto continue",
        "description": "Automatically go to next question when alternative is selected. This needs to be turned off to make the content fully accessible when using a screen reader.",
        "default": true
      },
      {
        "name": "timeoutCorrect",
        "type": "number",
        "label": "Timeout on correct answers",
        "importance": "low",
        "description": "Value in milliseconds",
        "default": 2000,
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "autoContinue",
              "equals": true
            }
          ]
        }
      },
      {
        "name": "timeoutWrong",
        "type": "number",
        "label": "Timeout on wrong answers",
        "importance": "low",
        "description": "Value in milliseconds",
        "default": 3000,
        "widget": "showWhen",
        "showWhen": {
          "rules": [
            {
              "field": "autoContinue",
              "equals": true
            }
          ]
        }
      },
      {
        "name": "soundEffectsEnabled",
        "type": "boolean",
        "label": "Enable sound effects",
        "importance": "low",
        "default": false
      },
      {
        "name": "enableRetry",
        "type": "boolean",
        "label": "Enable retry button",
        "importance": "low",
        "default": true
      },
      {
        "name": "enableSolutionsButton",
        "type": "boolean",
        "label": "Show correct answer when wrong",
        "description": "When enabled, the correct alternative is revealed after an incorrect response and on the results slide. When disabled, only whether the answer was right or wrong is shown.",
        "importance": "low",
        "default": false
      },
      {
        "name": "passPercentage",
        "type": "number",
        "label": "Pass percentage",
        "description": "Percentage of Total score required for passing the quiz.",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 100
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "Localize single choice set",
    "importance": "low",
    "common": true,
    "fields": [
