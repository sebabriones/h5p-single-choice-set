        "label": "Label for the \"Next\" button",
        "importance": "low",
        "default": "Next question"
      },
      {
        "name": "nextButton",
        "type": "text",
        "label": "Visual label for the \"Next\" button",
        "importance": "low",
        "default": "Next"
      },
      {
        "name": "showResultsButtonLabel",
        "type": "text",
        "label": "Label for the \"Show results\" button",
        "importance": "low",
        "default": "Show results"
      },
      {
        "name": "retryButtonLabel",
        "type": "text",
        "label": "Label for the \"Retry\" button",
        "importance": "low",
        "default": "Retry"
      },
      {
        "name": "solutionViewTitle",
        "type": "text",
        "label": "Title for the show solution view",
        "importance": "low",
        "default": "Solution list"
      },
      {
        "name": "correctText",
